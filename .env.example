# Copy to .env for a local or container run.
# Add as many cameras as you need in config/cameras.json (unlimited).

APP_SCRIPT=scripts/multi_camera_staff_tracking_v5_safe.py
CAMERAS_CONFIG=config/cameras.json

# Optional: override file config entirely (JSON array)
# CAMERAS_JSON=[{"id":"LOBBY-1","url":"rtsp://user:pass@host/stream"}]

# Optional: quick list without editing JSON (id|url pairs, semicolon-separated)
# CAMERAS=CAM-A|rtsp://a;CAM-B|rtsp://b

# Per-camera secrets (match url_env / fallback_env in cameras.json)
CAMERA_202_URL=
CAMERA_202_RTSP=
CAMERA_302_URL=
CAMERA_302_RTSP=
CAMERA_401_URL=
CAMERA_401_RTSP=

# Single-camera scripts (live tracking / recognition / RTSP test)
CAMERA_ID=
CAMERA_URL=
CAMERA_RTSP=

STAFF_GALLERY_PATH=
V4_YOLO_MODEL=
V4_YOLO_IMGSZ=
V4_YOLO_CONF=
V3_FACE_INTERVAL_SEC=
V4_GLOBAL_TTL_SEC=
V5_LOCAL_TRACK_REUSE_SEC=
V4_BODY_REID=
V4_REID_CHECKPOINT=
V4_FACE_VOTES_REQUIRED=
V4_FACE_VOTE_WINDOW_SEC=
V4_BODY_MATCH_THRESHOLD=
V4_FACE_MATCH_THRESHOLD=
V4_FACE_MARGIN=
